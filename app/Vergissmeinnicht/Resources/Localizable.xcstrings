    "Synchronisation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization"
          }
        }
      }
    },
    "Bei \"Bei jeder Änderung\" wird nach jeder Mutation ein Sync ausgelöst. Timer-Modi synchronisieren im Hintergrund. Manuell erfordert den Sync-Button in der Toolbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"On every change\" triggers a sync after each mutation. Timer modes synchronize in the background. \"Manual only\" requires using the sync button in the toolbar."
          }
        }
      }
    },
    "Sync-Fehler: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync error: %@"
          }
        }
      }
    },
    "%llu lokale Änderung(en) noch nicht synchronisiert": {
