          "stringUnit": {
            "state": "translated",
            "value": "Above the task list: \"Agenda\" groups by day with a project subtitle, \"Week strip\" shows a compact day bar. Tasks with a scheduled date appear as \"scheduled\". Calendar weeks follow the ISO standard (Monday-first week)."
          }
        }
      }
