            "state": "translated",
            "value": "Show calendar weeks"
          }
        }
      }
    },
    "Vorschau": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forecast"
          }
        }
      }
    },
    "Über der Aufgabenliste: \"Agenda\" gruppiert nach Tag mit Projekt-Untertitel, \"Wochen-Streifen\" zeigt eine kompakte Tagesleiste. Aufgaben mit Plantermin (scheduled) erscheinen als \"geplant\". Kalenderwochen folgen der ISO-Norm (Montag-erste Woche).": {
      "localizations": {
